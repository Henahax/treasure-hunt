{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.com/schemas/treasure-hunt.schema.json",
	"title": "Treasure Hunt",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "name", "description", "public", "steps"],
	"properties": {
		"id": {
			"$ref": "#/$defs/id",
			"description": "Unique URL-friendly identifier of the treasure hunt."
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"description": "Displayed name of the treasure hunt."
		},
		"description": {
			"type": "string",
			"description": "Description of the treasure hunt. May contain Markdown."
		},
		"public": {
			"type": "boolean",
			"description": "Whether this treasure hunt appears in the public catalog."
		},
		"picture": {
			"type": "string",
			"format": "uri",
			"description": "Optional banner image URL."
		},
		"steps": {
			"type": "array",
			"minItems": 1,
			"description": "Ordered list of steps. The array order determines the order of the game.",
			"items": {
				"$ref": "#/$defs/step"
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
			"description": "URL-friendly identifier using lowercase letters, numbers and hyphens."
		},

		"step": {
			"oneOf": [
				{
					"$ref": "#/$defs/textStep"
				},
				{
					"$ref": "#/$defs/passwordStep"
				},
				{
					"$ref": "#/$defs/locationStep"
				},
				{
					"$ref": "#/$defs/timeStep"
				}
			]
		},

		"baseStep": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "type", "content"],
			"properties": {
				"id": {
					"$ref": "#/$defs/id",
					"description": "Unique identifier of the step within the treasure hunt."
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"description": "Heading displayed for the step."
				},
				"type": {
					"type": "string",
					"enum": ["text", "password", "location", "time"]
				},
				"content": {
					"type": "array",
					"description": "Ordered list of content blocks.",
					"items": {
						"$ref": "#/$defs/content"
					}
				}
			}
		},

		"textStep": {
			"allOf": [
				{
					"$ref": "#/$defs/baseStep"
				},
				{
					"type": "object",
					"properties": {
						"type": {
							"const": "text"
						}
					}
				}
			]
		},

		"passwordStep": {
			"allOf": [
				{
					"$ref": "#/$defs/baseStep"
				},
				{
					"type": "object",
					"required": ["password"],
					"properties": {
						"type": {
							"const": "password"
						},
						"password": {
							"type": "string",
							"minLength": 1,
							"description": "Plain-text password required to unlock the next step."
						}
					}
				}
			]
		},

		"locationStep": {
			"allOf": [
				{
					"$ref": "#/$defs/baseStep"
				},
				{
					"type": "object",
					"required": ["location"],
					"properties": {
						"type": {
							"const": "location"
						},
						"location": {
							"$ref": "#/$defs/location"
						}
					}
				}
			]
		},

		"timeStep": {
			"allOf": [
				{
					"$ref": "#/$defs/baseStep"
				},
				{
					"type": "object",
					"required": ["time"],
					"properties": {
						"type": {
							"const": "time"
						},
						"time": {
							"type": "integer",
							"minimum": 0,
							"description": "Unix timestamp in seconds."
						}
					}
				}
			]
		},

		"location": {
			"type": "object",
			"additionalProperties": false,
			"required": ["latitude", "longitude", "radius"],
			"properties": {
				"latitude": {
					"type": "number",
					"minimum": -90,
					"maximum": 90,
					"description": "Latitude in decimal degrees."
				},
				"longitude": {
					"type": "number",
					"minimum": -180,
					"maximum": 180,
					"description": "Longitude in decimal degrees."
				},
				"radius": {
					"type": "number",
					"minimum": 0,
					"description": "Radius in meters."
				}
			}
		},

		"content": {
			"oneOf": [
				{
					"$ref": "#/$defs/textContent"
				},
				{
					"$ref": "#/$defs/videoContent"
				},
				{
					"$ref": "#/$defs/imageContent"
				},
				{
					"$ref": "#/$defs/linkContent"
				}
			]
		},

		"textContent": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "text"],
			"properties": {
				"type": {
					"const": "text"
				},
				"text": {
					"type": "string",
					"description": "Regular text or Markdown."
				}
			}
		},

		"videoContent": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "url"],
			"properties": {
				"type": {
					"const": "video"
				},
				"url": {
					"type": "string",
					"format": "uri",
					"description": "YouTube video URL. Optional t or start timestamp parameters are preserved in the embed."
				}
			}
		},

		"imageContent": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "url"],
			"properties": {
				"type": {
					"const": "image"
				},
				"url": {
					"type": "string",
					"format": "uri"
				}
			}
		},

		"linkContent": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "url"],
			"properties": {
				"type": {
					"const": "link"
				},
				"url": {
					"type": "string",
					"format": "uri"
				}
			}
		}
	}
}
